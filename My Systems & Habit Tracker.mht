@charset "utf-8";

:root { --bg-color: #000000; --card-bg: #0a0a0c; --border-color: rgba(255, 255, 255, 0.08); --text-main: #f8fafc; --text-muted: #71717a; --accent-green: #22c55e; --accent-pink: #ec4899; --accent-orange: #f97316; --accent-yellow: #eab308; --accent-blue: #3b82f6; }

* { box-sizing: border-box; margin: 0px; padding: 0px; font-family: "Plus Jakarta Sans", sans-serif; }

body { background-color: var(--bg-color); color: var(--text-main); min-height: 100vh; padding: 20px; }

.container { max-width: 900px; margin: 0px auto; }

header { text-align: center; margin-bottom: 25px; }

header h1 { font-size: 2.2rem; background: linear-gradient(to right, rgb(56, 189, 248), rgb(129, 140, 248), rgb(192, 132, 252)) text; -webkit-text-fill-color: transparent; margin-bottom: 8px; }

.quote-box { background: var(--card-bg); border: 1px solid var(--border-color); padding: 15px 20px; border-radius: 12px; text-align: center; margin-bottom: 25px; box-shadow: rgba(0, 0, 0, 0.5) 0px 4px 20px; }

.quote-box p { font-size: 0.95rem; color: rgb(56, 189, 248); font-weight: 500; }

.analytics-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 15px; margin-bottom: 25px; }

.stat-card { background: var(--card-bg); border: 1px solid var(--border-color); padding: 18px; border-radius: 12px; text-align: center; }

.stat-card h3 { font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 6px; }

.stat-card .value { font-size: 1.6rem; font-weight: 700; color: var(--text-main); }

.systems-container { display: grid; grid-template-columns: 1fr; gap: 20px; }

.system-card { background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 16px; padding: 20px; transition: 0.2s; }

.system-card:hover { border-color: rgba(255, 255, 255, 0.2); }

.system-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; }

.system-title { font-size: 1.1rem; font-weight: 600; display: flex; align-items: center; gap: 10px; }

.dot { width: 10px; height: 10px; border-radius: 50%; }

.days-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 6px; }

@media (max-width: 600px) {
  .days-grid { grid-template-columns: repeat(7, 1fr); }
}

.day-box { background: rgb(18, 18, 22); border: 1px solid var(--border-color); border-radius: 8px; padding: 8px 2px; text-align: center; cursor: pointer; transition: 0.2s; user-select: none; }

.day-box:hover { border-color: rgb(56, 189, 248); transform: translateY(-2px); }

.day-box .day-num { font-size: 0.65rem; color: var(--text-muted); margin-bottom: 2px; }

.day-box .day-status { font-size: 0.85rem; }

.day-box.completed { background: rgba(34, 197, 94, 0.15); border-color: var(--accent-green); animation: 0.4s ease 0s 1 normal none running pulseCheck; }

.day-box.completed .day-status { color: var(--accent-green); font-weight: bold; }

@keyframes pulseCheck { 
  0% { transform: scale(1); }
  50% { transform: scale(1.15); }
  100% { transform: scale(1); }
}

.sys-1 .dot { background-color: var(--accent-green); }

.sys-2 .dot { background-color: var(--accent-pink); }

.sys-3 .dot { background-color: var(--accent-orange); }

.sys-4 .dot { background-color: var(--accent-yellow); }

.sys-5 .dot { background-color: var(--accent-blue); }

#toast { visibility: hidden; position: fixed; bottom: 30px; left: 50%; transform: translateX(-50%); background: linear-gradient(135deg, rgb(34, 197, 94), rgb(22, 163, 74)); color: white; padding: 12px 24px; border-radius: 30px; font-weight: 600; box-shadow: rgba(0, 0, 0, 0.5) 0px 10px 25px; z-index: 1000; transition: opacity 0.3s, bottom 0.3s; }

#toast.show { visibility: visible; bottom: 50px; }

.footer-actions { display: flex; justify-content: center; gap: 15px; margin-top: 35px; }

.action-btn { background: transparent; border: 1px solid var(--border-color); color: var(--text-muted); padding: 8px 16px; border-radius: 8px; cursor: pointer; font-size: 0.85rem; transition: 0.2s; }

.action-btn:hover { border-color: rgb(56, 189, 248); color: rgb(56, 189, 248); }

.reset-btn:hover { border-color: rgb(239, 68, 68); color: rgb(239, 68, 68); }
